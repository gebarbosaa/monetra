{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "runtime": "container",
      "root": ".",
      "entrypoint": "self-hosting/backend/Dockerfile"
    },
    "frontend": {
      "framework": "vite",
      "root": "packages/frontend/"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "daemons": {
    "monetra-worker": {
      "root": ".",
      "entrypoint": "self-hosting/backend/Dockerfile",
      "command": [
        "/docker-entrypoint.sh",
        "/worker-entrypoint.sh"
      ],
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      }
    }
  }
}
